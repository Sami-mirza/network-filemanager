# Local Network File Manager settings.

# Flask session signing key (generated by setup scripts)
SECRET_KEY=change-me-to-a-long-random-string

# Optional login password (set one before allowing network access)
NETMANAGER_PASSWORD=

# Server port
NETMANAGER_PORT=8080

# Directory to share. Use an absolute path to share an existing folder.
# Examples: /home/alex/Documents or C:/Users/Alex/Documents
# Relative paths are based on the project folder.
NETMANAGER_DATA_DIR=./data
