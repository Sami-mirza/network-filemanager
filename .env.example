# Copy to .env and adjust. Used by docker compose and optional local runs.
#   cp .env.example .env

# Flask session signing key — set a long random string in production
SECRET_KEY=change-me-to-a-long-random-string

# Optional login password (leave empty for open access on trusted networks only)
NETMANAGER_PASSWORD=

# Listen port inside the container / process
NETMANAGER_PORT=8080

# Host port published by Docker Compose
HOST_PORT=8080

# Host directory mounted into container (for Docker Compose)
HOST_DATA_DIR=./data

# Directory served by the file manager when running directly (outside Docker)
NETMANAGER_DATA_DIR=./data
