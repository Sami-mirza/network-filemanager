@app.route('/rename', methods=['POST'])
def rename_item():
    path = request.form.get('path', '')
    src = safe_resolve(request.form.get('target', ''))
    name = clean_name(request.form.get('name'))
    if src == BASE_DIR or not os.path.exists(src):
        abort(404)
    if not name:
        flash('Invalid name.', 'err')
        return back_to(path)
    dst = os.path.join(os.path.dirname(src), name)
    if os.path.exists(dst):
        flash('That name already exists.', 'err')
    else:
        os.rename(src, dst)
        flash('Renamed successfully.', 'ok')
    return back_to(path)


@app.route('/delete', methods=['POST'])
def delete_item():
    path = request.form.get('path', '')
    target = safe_resolve(request.form.get('target', ''))
    if target == BASE_DIR or not os.path.exists(target):
        abort(404)
    try:
        if os.path.isdir(target) and not os.path.islink(target):
            shutil.rmtree(target)
        else:
            os.remove(target)
        flash('Deleted successfully.', 'ok')
    except OSError as e:
        flash(f'Could not delete: {e}', 'err')
    return back_to(path)


