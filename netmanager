def render(**kw):
    return render_template_string(HTML_TEMPLATE, csrf_token=session.get('csrf', ''),
                                  password_on=bool(PASSWORD), host_access=is_host_request(), **kw)


HOST_ONLY_ENDPOINTS = {
    'upload_file', 'make_dir', 'new_file', 'rename_item', 'delete_item',
    'save_file', 'edit_file',
}


def is_host_request():
    remote_addr = request.remote_addr
    if not remote_addr:
        return False
    try:
        return ipaddress.ip_address(remote_addr).is_loopback
    except ValueError:
        return False


# ───────────────────────── security ─────────────────────────
@app.before_request
def security():
    if request.endpoint in HOST_ONLY_ENDPOINTS and not is_host_request():
        abort(403, 'File changes are only allowed from the host computer.')
    if 'csrf' not in session:
        session['csrf'] = secrets.token_hex(16)
    if PASSWORD and not session.get('authenticated') and request.endpoint not in ('login',):
        return render(mode='login', error=False)
    if request.method == 'POST' and request.endpoint != 'login':
        if not hmac.compare_digest(request.form.get('csrf_token', ''), session['csrf']):
            abort(400, 'Bad CSRF token')


@app.after_request
def headers(resp):
    resp.headers['X-Content-Type-Options'] = 'nosniff'
    return resp


@app.route('/login', methods=['GET', 'POST'])
def login():
    if request.method == 'POST' and PASSWORD and \
            hmac.compare_digest(request.form.get('password', ''), PASSWORD):
        session['authenticated'] = True
        return redirect(url_for('browse_path'))
    return render(mode='login', error=request.method == 'POST')


@app.route('/logout')
def logout():
    session.clear()
    return redirect(url_for('login'))


# ───────────────────────── browsing ─────────────────────────
@app.route('/')
@app.route('/browse/')
@app.route('/browse/<path:path_url>')
def browse_path(path_url=""):
    target_dir = safe_resolve(path_url)
    if not os.path.isdir(target_dir):
        abort(404)
    try:
        entries = os.listdir(target_dir)
    except PermissionError:
        abort(403)

    items, total = [], 0
    for entry in entries:
        if entry.startswith('.'):
            continue
        full = os.path.join(target_dir, entry)
        try:
            st = os.stat(full)
        except OSError:
            continue
        is_dir = os.path.isdir(full)
        kind = None if is_dir else file_kind(full)
        if not is_dir:
            total += st.st_size
        items.append({
            'name': entry, 'is_dir': is_dir, 'rel_path': rel(full), 'kind': kind,
            'tag': TAGS.get(kind, 'BIN') if kind else 'DIR',
            'size': '' if is_dir else human_size(st.st_size),
            'mtime': human_time(st.st_mtime),
        })
    items.sort(key=lambda x: (not x['is_dir'], x['name'].lower()))
    n_dirs = sum(1 for i in items if i['is_dir'])

    return render(mode='list', items=items, current_rel_path=rel(target_dir),
                  parent_path=os.path.dirname(rel(target_dir)),
                  n_dirs=n_dirs, n_files=len(items) - n_dirs, total_size=human_size(total))


@app.route('/open/<path:file_path_url>')
def open_file(file_path_url):
    """Smart viewer: image/video/audio/pdf preview, text -> editor, binary -> info page."""
    target = safe_resolve(file_path_url)
    if not os.path.isfile(target):
        abort(404)
    kind = file_kind(target)
    if kind == 'text':
        return redirect(url_for('edit_file', file_path_url=file_path_url))
    st = os.stat(target)
    return render(mode='view', kind=kind,                   filename=os.path.basename(target), file_path_url=file_path_url,
                  parent_path=os.path.dirname(file_path_url), size=human_size(st.st_size),
                  mtime=human_time(st.st_mtime),
                  mime=mimetypes.guess_type(target)[0] or 'unknown type',
                  editable=(os.path.splitext(target)[1].lower() == '.svg'))


@app.route('/raw/<path:file_path_url>')
def raw_file(file_path_url):
    """Inline serving for previews (not forced download)."""
    target = safe_resolve(file_path_url)
    if not os.path.isfile(target):
        abort(404)
