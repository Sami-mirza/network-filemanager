def configure_from_args():
    """Apply CLI args over env defaults. Returns listen port."""
    global PASSWORD
    port = int(os.environ.get('NETMANAGER_PORT') or os.environ.get('PORT') or 8080)
    if len(sys.argv) > 1:
        try:
            port = int(sys.argv[1])
        except ValueError:
            print("Invalid port. Using default 8080.")
            port = 8080
    if len(sys.argv) > 2:
        PASSWORD = sys.argv[2]
    return port


def choose_shared_directory():
    """Prompt the local host to choose a readable and writable shared directory."""
    global BASE_DIR
    if not sys.stdin.isatty():
        return

    print("\nChoose the folder to share on your network.")
    print("Enter an existing folder path, or press Enter to keep the current folder.")
    while True:
        try:
            selected = input(f"Folder to share [{BASE_DIR}]: ").strip()
        except EOFError:
            print(f"\nUsing configured folder: {BASE_DIR}")
            return

        if not selected:
            return

        selected = os.path.realpath(os.path.abspath(os.path.expanduser(selected.strip('"'))))
        if not os.path.isdir(selected):
            print("That folder does not exist. Enter the path to an existing folder.")
            continue
        if not os.access(selected, os.R_OK | os.W_OK | os.X_OK):
            print("The app needs read and write access to that folder. Choose another folder or update its permissions.")
            continue

        env_path = os.path.join(APP_DIR, '.env')
        try:
            with open(env_path, 'r', encoding='utf-8') as env_file:
                lines = env_file.readlines()
        except FileNotFoundError:
            lines = []
        except OSError as error:
            sys.exit(f"Could not read {env_path}: {error}")

        setting = f"NETMANAGER_DATA_DIR={selected}\n"
        found = False
        updated_lines = []
        for line in lines:
            if re.match(r'^\s*NETMANAGER_DATA_DIR\s*=', line):
                if not found:
                    updated_lines.append(setting)
                    found = True
            else:
                updated_lines.append(line)
        if not found:
            if updated_lines and not updated_lines[-1].endswith('\n'):
                updated_lines[-1] += '\n'
            updated_lines.append(setting)
        try:
            with open(env_path, 'w', encoding='utf-8') as env_file:
                env_file.writelines(updated_lines)
        except OSError as error:
            sys.exit(f"Could not save the selected folder to {env_path}: {error}")

        BASE_DIR = selected
        os.environ['NETMANAGER_DATA_DIR'] = selected
        print(f"Saved shared folder: {BASE_DIR}")
        return


if __name__ == '__main__':
    choose_shared_directory()
    PORT = configure_from_args()
    if not port_free(PORT):
        for alt in range(PORT + 1, PORT + 50):
            if port_free(alt):
                print(f"Port {PORT} is busy, using {alt} instead.")
                PORT = alt
                break
        else:
            sys.exit(f"Port {PORT} is busy and no free port was found nearby.")
    ip = get_real_ip()
    print("\nFile Manager running")
    print(f"Directory: {BASE_DIR}")
    print(f"Security: {'PASSWORD PROTECTED' if PASSWORD else 'NO PASSWORD (open to your local network)'}")
    print(f"Local: http://localhost:{PORT}")
    print(f"Network: http://{ip}:{PORT}\n")
    try:
        from waitress import serve
        serve(app, host='0.0.0.0', port=PORT)
    except ImportError:
        app.run(host='0.0.0.0', port=PORT, debug=False)
