@app.route('/zip/<path:path_url>')
def download_zip(path_url=""):
    target = safe_resolve(path_url)
    if not os.path.isdir(target):
        abort(404)
    buf = io.BytesIO()
    with zipfile.ZipFile(buf, 'w', zipfile.ZIP_DEFLATED) as z:
        for root, dirs, files in os.walk(target):
            dirs[:] = [d for d in dirs if not d.startswith('.')]
            for f in files:
                if f.startswith('.'):
                    continue
                full = os.path.join(root, f)
                if os.path.realpath(full).startswith(BASE_DIR):
                    z.write(full, os.path.relpath(full, target))
    buf.seek(0)
    name = (os.path.basename(target) or 'files') + '.zip'
    return send_file(buf, as_attachment=True, download_name=name, mimetype='application/zip')


