IMAGE_EXT = {'.png', '.jpg', '.jpeg', '.gif', '.webp', '.bmp', '.svg', '.ico', '.avif'}
VIDEO_EXT = {'.mp4', '.webm', '.mkv', '.mov', '.ogv'}
AUDIO_EXT = {'.mp3', '.wav', '.ogg', '.m4a', '.flac', '.aac'}
TAGS = {'image': 'IMG', 'video': 'VID', 'audio': 'AUD', 'pdf': 'PDF', 'text': 'TXT',
        'archive': 'ZIP', 'binary': 'BIN'}
ARCHIVE_EXT = {'.zip', '.tar', '.gz', '.rar', '.7z', '.bz2', '.xz'}


# ───────────────────────── helpers ─────────────────────────
def get_real_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(2)
    try:
        s.connect(('8.8.8.8', 1))
        return s.getsockname()[0]
    except Exception:
        return '127.0.0.1'
    finally:
        s.close()


def port_free(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        return s.connect_ex(('127.0.0.1', port)) != 0


def safe_resolve(path_url):
    """Resolve a user path inside BASE_DIR (blocks ../ and symlink escapes)."""
    target = os.path.realpath(os.path.join(BASE_DIR, path_url or ''))
    try:
        if os.path.commonpath([BASE_DIR, target]) != BASE_DIR:
            abort(403)
    except ValueError:
        abort(403)
    return target


def rel(path):
    r = os.path.relpath(path, BASE_DIR).replace('\\', '/')
    return '' if r == '.' else r


def human_size(n):
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if n < 1024:
            return f"{n:.0f} {unit}" if unit == 'B' else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} PB"


def human_time(ts):
    return datetime.fromtimestamp(ts).strftime('%Y-%m-%d %H:%M')


def file_kind(path):
    """image | video | audio | pdf | archive | text | binary"""
    ext = os.path.splitext(path)[1].lower()
    if ext in IMAGE_EXT:
        return 'image'
    if ext in VIDEO_EXT:
        return 'video'
    if ext in AUDIO_EXT:
        return 'audio'
    if ext == '.pdf':
        return 'pdf'
    if ext in ARCHIVE_EXT:
        return 'archive'
    return 'text' if is_text_file(path) else 'binary'


def is_text_file(path):
    """Real content check: no NUL bytes and valid UTF-8."""
    try:
        with open(path, 'rb') as f:
            chunk = f.read(8192)
    except OSError:
        return False
    if not chunk:
        return True
    if b'\0' in chunk:
        return False
    try:
        codecs.getincrementaldecoder('utf-8')().decode(chunk, final=False)
        return True
    except UnicodeDecodeError:
        return False


def clean_name(name):
    name = secure_filename((name or '').strip())
    if not name or name.startswith('.'):
        return None
    return name


def back_to(path_url):
    return redirect(url_for('browse_path', path_url=path_url))


