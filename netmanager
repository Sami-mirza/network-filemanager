AUDIO_EXT = {'.mp3', '.wav', '.ogg', '.m4a', '.flac', '.aac'}
TAGS = {'image': 'IMG', 'video': 'VID', 'audio': 'AUD', 'pdf': 'PDF', 'text': 'TXT',
