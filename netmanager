def configure_from_args():
    """Apply CLI args over env defaults. Returns listen port."""
    global PASSWORD
    port = int(os.environ.get('NETMANAGER_PORT') or os.environ.get('PORT') or 8080)
    if len(sys.argv) > 1:
        try:
            port = int(sys.argv[1])
        except ValueError:
            print("Invalid port. Using default 8080.")
            port = 8080
    if len(sys.argv) > 2:
        PASSWORD = sys.argv[2]
    return port


def find_mtp_mounts(mtp_address, mount_roots=None):
    """Translate a GVFS MTP URI to matching paths under mounted GVFS devices."""
    parsed = urlsplit(mtp_address)
    if parsed.scheme.lower() != 'mtp':
        return []

    path_parts = [unquote(part) for part in parsed.path.split('/') if part]
    if not parsed.netloc and path_parts:
        path_parts = path_parts[1:]
    if not path_parts or any(part in ('.', '..') for part in path_parts):
        return []

    if mount_roots is None:
        uid = getattr(os, 'getuid', lambda: None)()
        mount_roots = [f'/run/user/{uid}/gvfs'] if uid is not None else []

    matches = set()
    for mount_root in mount_roots:
        try:
            with os.scandir(mount_root) as entries:
                for entry in entries:
                    if not entry.name.startswith('mtp:') or not entry.is_dir():
                        continue
                    mount_path = os.path.realpath(entry.path)
                    candidate = os.path.realpath(os.path.join(mount_path, *path_parts))
                    try:
                        if os.path.commonpath([mount_path, candidate]) == mount_path and os.path.isdir(candidate):
                            matches.add(candidate)
                    except ValueError:
                        continue
        except OSError:
            continue
    return sorted(matches)


def discover_shared_directories(platform_name=None, home=None, mount_roots=None):
    """Find common personal folders and currently mounted external storage."""
    platform_name = platform_name or sys.platform
    home = os.path.realpath(home or os.path.expanduser('~'))
    candidates = []

    def add(label, path, allow_read_only=False):
        if os.path.isdir(path) and os.access(path, os.R_OK | os.X_OK):
            real_path = os.path.realpath(path)
            if all(existing_path != real_path for _, existing_path in candidates):
                writable = os.access(real_path, os.W_OK)
                if writable or allow_read_only:
                    suffix = '' if writable else ' (read-only)'
                    candidates.append((f'{label}{suffix}', real_path))

    def add_device_folders(label, root):
        add(label, root, allow_read_only=True)
        try:
            with os.scandir(root) as first_level:
                children = [entry for entry in first_level if entry.is_dir()]
        except OSError:
            return

        for child in children:
            child_label = f'{label} / {child.name}'
            add(child_label, child.path, allow_read_only=True)
            if child.name.lower() not in ('internal shared storage', 'shared', 'storage'):
                continue
            try:
                with os.scandir(child.path) as second_level:
                    for folder in second_level:
                        if folder.is_dir():
                            add(f'{child_label} / {folder.name}', folder.path, allow_read_only=True)
            except OSError:
                continue

    add('Home folder', home)
    for folder_name, label in (
        ('Desktop', 'Desktop'),
        ('Documents', 'Documents'),
        ('Downloads', 'Downloads'),
        ('Pictures', 'Pictures'),
        ('Music', 'Music'),
        ('Videos', 'Videos'),
    ):
        add(label, os.path.join(home, folder_name))

    if mount_roots is None:
        if platform_name == 'win32':
            mount_roots = [f'{letter}:\\' for letter in 'DEFGHIJKLMNOPQRSTUVWXYZ']
        elif platform_name == 'darwin':
            mount_roots = ['/Volumes']
        else:
            uid = getattr(os, 'getuid', lambda: None)()
            mount_roots = [os.path.join('/media', os.path.basename(home)), '/media', '/mnt']
            if uid is not None:
                mount_roots.append(f'/run/user/{uid}/gvfs')

    for mount_root in mount_roots:
        try:
            if platform_name in ('win32', 'darwin'):
                entries = [(os.path.basename(os.path.normpath(mount_root)), mount_root)]
                if platform_name == 'darwin':
                    with os.scandir(mount_root) as scanned:
                        entries = [(entry.name, entry.path) for entry in scanned if entry.is_dir()]
            else:
                with os.scandir(mount_root) as scanned:
                    entries = [(entry.name, entry.path) for entry in scanned if entry.is_dir()]
        except OSError:
            continue

        for name, path in entries:
            if platform_name == 'darwin':
                label = f'External volume: {name}'
            elif platform_name == 'win32':
                label = f'Drive: {name}'
            elif mount_root.endswith('/gvfs'):
                label = f'Connected device: {name}'
            else:
                label = f'Mounted drive: {name}'
            add_device_folders(label, path)

    return candidates


def save_shared_directory(selected):
    """Persist the selected shared folder in the project .env file."""
    global BASE_DIR
    env_path = os.path.join(APP_DIR, '.env')
    try:
        with open(env_path, 'r', encoding='utf-8') as env_file:
            lines = env_file.readlines()
    except FileNotFoundError:
        lines = []
    except OSError as error:
        sys.exit(f"Could not read {env_path}: {error}")

    setting = f"NETMANAGER_DATA_DIR={selected}\n"
    found = False
    updated_lines = []
    for line in lines:
        if re.match(r'^\s*NETMANAGER_DATA_DIR\s*=', line):
            if not found:
                updated_lines.append(setting)
                found = True
        else:
            updated_lines.append(line)
    if not found:
        if updated_lines and not updated_lines[-1].endswith('\n'):
            updated_lines[-1] += '\n'
        updated_lines.append(setting)
    try:
        with open(env_path, 'w', encoding='utf-8') as env_file:
            env_file.writelines(updated_lines)
    except OSError as error:
        sys.exit(f"Could not save the selected folder to {env_path}: {error}")

    BASE_DIR = selected
    os.environ['NETMANAGER_DATA_DIR'] = selected
    print(f"Saved shared folder: {BASE_DIR}")


def choose_shared_directory():
    """Prompt the local host to choose a readable and writable shared directory."""
    global BASE_DIR
    if not sys.stdin.isatty():
        return

    print("\nChoose the folder to share on your network.")
    candidates = discover_shared_directories()
    print("Folders and connected storage:")
    for index, (label, path) in enumerate(candidates, 1):
        print(f"  {index}. {label} — {path}")
    print("  M. Enter a folder path manually")
    print("Choose a number, enter M for a path, or press Enter to keep the current folder.")
    while True:
        try:
            selected = input(f"Folder choice [{BASE_DIR}]: ").strip()
        except EOFError:
            print(f"\nUsing configured folder: {BASE_DIR}")
            return

        if not selected:
            if not os.path.isdir(BASE_DIR):
                print(f"The saved folder is not currently mounted or does not exist: {BASE_DIR}")
                print("Enter an available folder path to share.")
                continue
            if not os.access(BASE_DIR, os.R_OK | os.W_OK | os.X_OK):
                print(f"The saved folder is not readable and writable: {BASE_DIR}")
                print("Enter an available folder path to share.")
                continue
            return

        if selected.isdigit():
            choice = int(selected)
            if 1 <= choice <= len(candidates):
                selected = candidates[choice - 1][1]
            else:
                print(f"Choose a number from 1 to {len(candidates)}, M, or press Enter.")
                continue
        elif selected.lower() == 'm':
            try:
                selected = input("Enter the full folder path: ").strip()
            except EOFError:
                print(f"\nUsing configured folder: {BASE_DIR}")
                return
            if not selected:
                continue
            if selected.isdigit():
                print("M expects a folder path, not a menu number. Enter a full path such as /media/sam/USB.")
                continue

        selected = selected.strip('"')
        if selected.lower().startswith('mtp:'):
            matches = find_mtp_mounts(selected)
            if len(matches) == 1:
                selected = matches[0]
                print(f"Found mounted phone folder: {selected}")
            elif len(matches) > 1:
                print("More than one mounted device has that folder. Enter one of these filesystem paths instead:")
                for path in matches:
                    print(f"  {path}")
                continue
            else:
                print("Could not find that folder in the mounted GVFS phone storage.")
                print("On Linux, unlock the phone, choose File Transfer, and open it in your file manager first.")
                print("Then check the mounted path with: ls \"/run/user/$(id -u)/gvfs\"")
                print("Enter the corresponding /run/user/.../gvfs/mtp:... filesystem path.")
                continue

        selected = os.path.realpath(os.path.abspath(os.path.expanduser(selected)))
        if not os.path.isdir(selected):
            print("That folder does not exist. Choose a listed number or enter the full path with M.")
            continue
        if not os.access(selected, os.R_OK | os.W_OK | os.X_OK):
            print("This folder is read-only or inaccessible. Choose a writable folder; CD-ROMs cannot be used for uploads.")
            continue

        save_shared_directory(selected)
        return


if __name__ == '__main__':
    choose_shared_directory()
    if not os.path.isdir(BASE_DIR) or not os.access(BASE_DIR, os.R_OK | os.W_OK | os.X_OK):
