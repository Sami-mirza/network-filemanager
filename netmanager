@app.route('/upload', methods=['POST'])
def upload_file():
    path = request.form.get('path', '')
    target_dir = safe_resolve(path)
    saved = 0
    for file in request.files.getlist('files'):
        name = secure_filename(file.filename or '')
        if not name:
